{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abhay-soni-portfolio",
  "account_id": "e132edc1a02bb75786ff734bc3563fb",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/app-router-entry",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "vars": {
    "ADMIN_EMAIL": "abhispacesoni@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "abhay-soni-portfolio-db",
      "database_id": "41277614-0714-48be-a4f5-a35dcdf1c6fe",
      "migrations_dir": "drizzle"
    }
  ]
}
